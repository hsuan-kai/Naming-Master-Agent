# .env
# Configuration for Google Cloud Agent Engine

# The region for your agent (e.g., us-central1)
GOOGLE_CLOUD_LOCATION="us-central1"

# 1 = Use Vertex AI (Enterprise), 0 = Use AI Studio (API Key)
# We set to 0 because our code uses genai.configure(api_key=...)
GOOGLE_GENAI_USE_VERTEXAI=0

# Project ID (Optional here, usually set in environment)
# GOOGLE_CLOUD_PROJECT="your-project-id"
